Dataset attention {
  label: 'Attention'
  description: ''
  data_source_name: 'vc_data_warehouse'
  models: [
    data_pipeline_attention_seconds,
    data_pipeline_campaign_reporting_ads,
    data_pipeline_campaign_reporting_campaigns,
    data_pipeline_campaign_reporting_flights,
    data_pipeline_properties,
    data_pipeline_screens
  ]
  relationships: [
    relationship(data_pipeline_attention_seconds.campaign_id > data_pipeline_campaign_reporting_campaigns.campaign_id, true),
    relationship(data_pipeline_attention_seconds.property_id > data_pipeline_properties.id, true)
  ]
  owner: 'ganonuevo@verticalcity.com'

  metric average_attention_seconds {
    label: "Average Attention Seconds"
    type: "number"
    hidden: false
    description: ""
    definition: @aql avg(data_pipeline_attention_seconds.attention_seconds_true);;
    format: "none"
  }
}