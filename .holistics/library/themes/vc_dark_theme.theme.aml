const vc_dark_theme_tokens = {
  primary: "oklch(0.62 0.17 288)",  secondary: "oklch(0.77 0.13 185)",  mode: "dark",
  background: "oklch(0.26 0.012 270)",  canvas_bg: "oklch(0.28 0.012 270)",  block_bg: "oklch(0.31 0.014 270)",
  text_primary: "oklch(0.95 0.005 270)",  text_muted: "oklch(0.80 0.01 270)",  text_subtle: "oklch(0.66 0.012 270)",
  border: "oklch(0.38 0.015 270)",  focus_ring: "oklch(0.70 0.14 288)",
  semantic_success: "oklch(0.74 0.15 150)",  semantic_warning: "oklch(0.80 0.14 80)",  semantic_danger: "oklch(0.70 0.17 25)",
  font_body: "Inter",  font_display: "Inter",
  corner_style: "rounded",  density: "comfortable",  elevation: "hairline"
}

ColorPalette vc_dark_palette {
  title: "Vertical City Dark"
  categorical {
    colors: [
      "oklch(0.60 0.17 288)",
      "oklch(0.66 0.12 185)",
      "oklch(0.66 0.15 55)",
      "oklch(0.68 0.13 240)",
      "oklch(0.60 0.17 15)",
      "oklch(0.64 0.15 140)",
      "oklch(0.62 0.17 335)",
      "oklch(0.74 0.13 95)"
    ]
  }
}

PageTheme vc_dark_theme {
  title: "Vertical City Dark"
  color { data: vc_dark_palette }
  background { bg_color: vc_dark_theme_tokens("background") }
  canvas {
    background { bg_color: vc_dark_theme_tokens("canvas_bg") }
    border {
      border_width: 0
      border_radius: 12
      border_color: vc_dark_theme_tokens("border")
      border_style: "none"
    }
    shadow: "none"
    opacity: 1
  }
  block {
    background { bg_color: vc_dark_theme_tokens("block_bg") }
    border {
      border_width: 1
      border_style: "solid"
      border_radius: 12
      border_color: vc_dark_theme_tokens("border")
    }
    shadow: "none"
    padding: 16
    opacity: 1
    label {
      font_family: vc_dark_theme_tokens("font_display")
      font_size: 14
      font_color: vc_dark_theme_tokens("text_primary")
      font_weight: "semibold"
      font_style: "normal"
      letter_spacing: "0"
    }
    text {
      font_family: vc_dark_theme_tokens("font_body")
      font_size: 13
      font_color: vc_dark_theme_tokens("text_muted")
      font_weight: "normal"
      font_style: "normal"
    }
  }
  viz {
    table {
      general {
        bg_color: vc_dark_theme_tokens("block_bg")
        font_color: vc_dark_theme_tokens("text_muted")
        font_family: vc_dark_theme_tokens("font_body")
        font_size: 13
        border_color: vc_dark_theme_tokens("border")
        grid_color: vc_dark_theme_tokens("border")
        border_width: 1
        hover_color: "oklch(0.36 0.014 270)"
        banding_color: "oklch(0.335 0.014 270)"
        cell_padding: DetailedSpacing { top: 10, right: 16, bottom: 10, left: 16 }
        borders { outer: true, vertical: false, horizontal: true, header: true, row_header: false }
      }
      header {
        bg_color: vc_dark_theme_tokens("background")
        font_color: vc_dark_theme_tokens("text_primary")
        font_size: 13
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "oklch(0.335 0.014 270)"
        font_color: vc_dark_theme_tokens("text_muted")
        font_size: 13
        font_weight: "medium"
      }
      sub_title {
        font_color: vc_dark_theme_tokens("text_subtle")
        font_size: 12
        font_weight: "medium"
      }
      sparkline {
        line { color: vc_dark_theme_tokens("primary") }
        column { color: vc_dark_theme_tokens("primary") }
      }
    }
    metric_kpi {
      alignment: "left"
      label {
        font_family: vc_dark_theme_tokens("font_body")
        font_size: 20
        font_color: vc_dark_theme_tokens("text_muted")
      }
      value {
        font_family: vc_dark_theme_tokens("font_display")
        font_size: 48
        font_color: vc_dark_theme_tokens("text_primary")
      }
      progress {
        indicator { bg_color: vc_dark_theme_tokens("primary") }
        track { bg_color: vc_dark_theme_tokens("border") }
        text { font_color: vc_dark_theme_tokens("text_muted") }
      }
      trend {
        positive { text { font_color: vc_dark_theme_tokens("semantic_success") font_weight: "medium" }  background { bg_color: "oklch(0.40 0.06 150)" } }
        negative { text { font_color: vc_dark_theme_tokens("semantic_danger") font_weight: "medium" }  background { bg_color: "oklch(0.40 0.07 25)" } }
        neutral  { text { font_color: vc_dark_theme_tokens("text_muted") font_weight: "normal" }  background { bg_color: "oklch(0.38 0.01 270)" } }
      }
    }
  }
  custom_css: @css
    .dac-text-block {
      font-family: Inter;
      font-size: 14px;
      color: oklch(0.80 0.01 270);
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
      font-family: Inter;
      color: oklch(0.95 0.005 270);
      line-height: 1.3;
      margin-top: 0;
      margin-bottom: 0.5em;
      font-weight: 600;
    }
  ;;
}
