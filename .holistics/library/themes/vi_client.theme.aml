        negative { text { font_color: vi_client_brand("semantic_danger_dark") font_weight: "medium" }  background { bg_color: "oklch(0.40 0.08 20)" } }
        neutral  { text { font_color: vi_client_brand("text_muted_dark") font_weight: "normal" }  background { bg_color: "oklch(0.38 0.05 250)" } }
      }
    }
  }
  custom_css: @css
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap');
    .dac-text-block {
      font-family: Inter;
      font-size: 14px;
      color: oklch(0.805 0.063 233);
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
