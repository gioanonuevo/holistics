        font_family: vi_client_brand("font_body")
        font_size: 13
        border_color: vi_client_brand("border_dark")
        grid_color: vi_client_brand("border_dark")
        border_width: 1
        hover_color: "oklch(0.36 0.074 254)"
        banding_color: "oklch(0.34 0.074 254)"
        cell_padding: DetailedSpacing { top: 10, right: 16, bottom: 10, left: 16 }
        borders { outer: true, vertical: false, horizontal: true, header: true, row_header: false }
      }
      header {
        bg_color: vi_client_brand("background_dark")
        font_color: vi_client_brand("text_primary_dark")
