  view: CanvasLayout {
    label: 'V+ Report Extract'
    width: 1300
    height: 2460
    grid_size: 20
    auto_expand_vertically: true
    block t_intro {
      position: pos(20, 20, 1260, 260)
    }
    block f_report {
      position: pos(20, 300, 620, 80)
    }
    block v_totals {
      position: pos(20, 400, 1260, 160)
      layer: 1
    }
    block v_report {
      position: pos(20, 580, 1260, 880)
      layer: 1
    }
    block f_delivery {
      position: pos(20, 1500, 620, 80)
    }
    block f_delivery_ads {
      position: pos(660, 1500, 620, 80)
    }
    block v_delivery {
      position: pos(20, 1600, 1260, 160)
      layer: 1
    }
    block v_flights {
      position: pos(20, 1780, 1260, 220)
      layer: 1
    }
    block v_served_by_ad {
      position: pos(20, 2020, 1260, 380)
      layer: 1
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: DynamicPageTheme {
    light: H.themes.vanilla
    dark: H.themes.charcoal
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_report'
      to: [
        'v_totals',
        'v_report'
      ]
      field: r(attention_base.report_filter)
    },
    FilterInteraction {
      from: 'f_delivery'
      to: [
        'v_delivery',
        'v_flights',
        'v_served_by_ad'
      ]
      field: r(vplus_served_impressions.campaign_id)
    },
    FilterInteraction {
      from: 'f_delivery_ads'
      to: [
        'v_delivery',
        'v_flights',
        'v_served_by_ad'
      ]
      field: r(vplus_served_impressions.ad_id)
    }
  ]
}
