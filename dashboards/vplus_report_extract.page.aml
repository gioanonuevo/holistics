  block v_served_by_ad: VizBlock {
    label: 'Served impressions by ad (inside the flight window)'
    viz: DataTable {
      dataset: vplus_delivery
      fields: [
        VizFieldFull {
          ref: r(vplus_served_impressions.campaign_id)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(vplus_served_impressions.ad_id)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(vplus_served_impressions.window_start)
          format {
            type: 'date'
          }
        },
        VizFieldFull {
          ref: r(vplus_served_impressions.window_end)
          format {
            type: 'date'
          }
        },
        VizFieldFull {
          ref: r(vplus_delivery.served_impressions)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
      ]
