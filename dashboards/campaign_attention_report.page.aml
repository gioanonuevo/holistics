  // ---------------------------------------------------------------------------
  // Interactions: the one control drives every data block on every tab.
  // ---------------------------------------------------------------------------
  explicit_interactions: [
    FilterInteraction {
      from: 'f_report'
      to: [
        'k_campaign_avg',
        'k_vs_network',
        'k_datapoints',
        'k_screens',
        'v_window',
        'v_trend',
        'v_exposure',
        'v_format',
        'v_ad_chart',
        'v_ads',
        'v_gallery',
        'v_age',
        'v_gender',
        'v_gender_age',
        'v_city_chart',
        'v_city',
        'v_province',
        'v_property',
        'v_screen_location'
      ]
      field: r(attention_base.report_filter)
    }
  ]

  // ---------------------------------------------------------------------------
  // View: four tabs, control row at the top of each, AI callouts above the charts.
  // ---------------------------------------------------------------------------
  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1300
      height: 1900
      grid_size: 20
      auto_expand_vertically: true
      default_zoom: 'fit_to_width'
      block b_title {
        position: pos(20, 20, 1260, 120)
        layer: 1
      }
      block f_report {
        position: pos(20, 160, 620, 100)
        layer: 1
      }
      block k_campaign_avg {
        position: pos(20, 280, 300, 140)
        layer: 1
      }
      block k_vs_network {
        position: pos(340, 280, 300, 140)
        layer: 1
      }
      block k_datapoints {
        position: pos(660, 280, 300, 140)
        layer: 1
      }
      block k_screens {
        position: pos(980, 280, 300, 140)
        layer: 1
      }
      block v_window {
        position: pos(20, 440, 1260, 140)
        layer: 1
      }
      block ai_overview {
        position: pos(20, 600, 1260, 320)
        layer: 1
      }
      block h_trend {
        position: pos(20, 940, 1260, 80)
        layer: 1
      }
      block v_trend {
        position: pos(20, 1040, 1260, 420)
        layer: 1
      }
      block h_mix {
        position: pos(20, 1480, 1260, 80)
        layer: 1
      }
      block v_exposure {
        position: pos(20, 1580, 620, 300)
        layer: 1
      }
      block v_format {
        position: pos(660, 1580, 620, 300)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }

    tab creatives: CanvasLayout {
      label: 'Creatives'
      width: 1300
      height: 2400
      grid_size: 20
      auto_expand_vertically: true
      default_zoom: 'fit_to_width'
      block f_report {
        position: pos(20, 20, 620, 100)
        layer: 1
      }
      block h_creatives {
        position: pos(20, 140, 1260, 80)
        layer: 1
      }
      block ai_creatives {
        position: pos(20, 240, 1260, 320)
        layer: 1
      }
      block v_ad_chart {
        position: pos(20, 580, 1260, 420)
        layer: 1
      }
      block v_gallery {
        position: pos(20, 1020, 1260, 780)
        layer: 1
      }
      block v_ads {
        position: pos(20, 1820, 1260, 560)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }

    tab audience: CanvasLayout {
      label: 'Audience'
      width: 1300
      height: 1500
      grid_size: 20
      auto_expand_vertically: true
      default_zoom: 'fit_to_width'
      block f_report {
        position: pos(20, 20, 620, 100)
        layer: 1
      }
      block h_audience {
        position: pos(20, 140, 1260, 80)
        layer: 1
      }
      block ai_audience {
        position: pos(20, 240, 1260, 320)
        layer: 1
      }
      block v_age {
        position: pos(20, 580, 620, 400)
        layer: 1
      }
      block v_gender {
        position: pos(660, 580, 620, 400)
        layer: 1
      }
      block v_gender_age {
        position: pos(20, 1000, 1260, 480)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }

    tab markets: CanvasLayout {
      label: 'Markets & Placement'
      width: 1300
      height: 1760
      grid_size: 20
      auto_expand_vertically: true
      default_zoom: 'fit_to_width'
      block f_report {
        position: pos(20, 20, 620, 100)
        layer: 1
      }
      block h_markets {
        position: pos(20, 140, 1260, 80)
        layer: 1
      }
      block ai_markets {
        position: pos(20, 240, 1260, 320)
        layer: 1
      }
      block v_city_chart {
        position: pos(20, 580, 1260, 400)
        layer: 1
      }
      block v_city {
        position: pos(20, 1000, 620, 400)
        layer: 1
      }
      block v_province {
        position: pos(660, 1000, 620, 400)
        layer: 1
      }
      block v_property {
        position: pos(20, 1420, 620, 320)
        layer: 1
      }
      block v_screen_location {
        position: pos(660, 1420, 620, 320)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
  }
}