  block t_attention_banner: TextBlock {
    content: @md
<div style="background:#6C4DC4;color:#ffffff;font-weight:700;letter-spacing:1px;font-size:16px;padding:14px 18px;clip-path:polygon(0 0,100% 0,98% 100%,0 100%);">ATTENTION SUMMARY</div>
    ;;
  }

  block k_avg_attention: VizBlock {
    label: 'Avg Attention in Seconds'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      values: [
        VizFieldFull {
          ref: r(attention.campaign_average_attention_seconds)
          label: 'Avg Attention in Seconds'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        }
      ]
      content: @md
        <style>
        .bd-card-k-avg-attention {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          height: 100%;
          padding: 0.5rem;
          box-sizing: border-box;
        }
        .bd-head-k-avg-attention {
          font-size: 15px;
          font-weight: 600;
          margin-bottom: 10px;
          color: inherit;
        }
        .bd-caption-k-avg-attention {
          font-size: 13px;
          margin-bottom: 4px;
          color: #6C4DC4;
        }
        .bd-value-k-avg-attention {
          font-size: 30px;
          font-weight: 400;
          line-height: 1.25;
          color: #6C4DC4;
        }
        </style>

        <div class="bd-card-k-avg-attention">
          <div class="bd-head-k-avg-attention">Average Attention</div>
          <div class="bd-caption-k-avg-attention">Avg Attention in Seconds</div>
          <div class="bd-value-k-avg-attention">{{ rows[0].values.`Avg Attention in Seconds`.formatted }}</div>
        </div>
      ;;
    }
  }

