          <div class="bd-head-k-vs-ooh">&nbsp;</div>
          <div class="bd-caption-k-vs-ooh">vs avg Traditional OOH</div>
          <div class="bd-value-k-vs-ooh">{{ rows[0].values.`vs avg Traditional OOH`.formatted }}</div>
