@tag('Status/Draft')
Dashboard core_dashboard {
  title: 'Core Dashboard'
  description: @md In-flight view of one campaign: flight summary, attention against other media and the network, attention over time, audience by gender and age, creative performance and impressions by week, property and city. Rebuilt from the Looker In-Flight Campaign Optimization Dashboard (Internal). Pick a flight id at the top to load a campaign. ;;
  owner: 'ganonuevo@verticalcity.com'
  theme: H.themes.classic

  // ---------------------------------------------------------------------------
  // One control drives both datasets through per-block field mappings (see interactions):
  //   vplus_delivery blocks -> the flight id dimension (raw_campaigns.id)
  //   attention blocks      -> the attention_base.report_filter PARAM (clips the flight window);
  //                            they also carry the condition
  //                            filter_model.report_filter in attention_base.report_filter
  // Confirmed in the UI on 2026-11-27: a dimension-sourced control does feed the param when it
  // is mapped explicitly with CustomMapping. The default is kept on purpose: an empty control
  // means all flights.
  // ---------------------------------------------------------------------------
  block flight_id: FilterBlock {
    label: 'Flight ID'
    type: 'field'
    source: FieldFilterSource {
      dataset: vplus_delivery
      field: r(vplus_flight_facts.campaign_id)
    }
    default {
      operator: 'is'
      value: ['10605']
    }
    settings {
      input_type: 'multiple'
    }
  }

  block t_header: TextBlock {
    content: @md
<div style="background:#6C4DC4;color:#ffffff;font-weight:700;letter-spacing:1px;font-size:16px;padding:14px 18px;clip-path:polygon(0 0,100% 0,98% 100%,0 100%);">FLIGHT SUMMARY</div>
    ;;
  }

  block t_logo: TextBlock {
    content: @md
<div style="text-align:right;padding:8px 12px 0 0;"><img src="https://uploads-ssl.webflow.com/5de034f7b1a94eee0c714fde/5e879e904fbaeaf7b6177f84_VI_Logo_140px.png" alt="Vertical Impression" style="height:44px;width:auto;" /></div>
    ;;
  }

  block v_date_range: VizBlock {
    label: 'Date Range'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: vplus_delivery
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.flight_start)
          label: 'Flight Start'
          format {
            type: 'date'
            pattern: 'LLL d, yyyy'
          }
        },
        VizFieldFull {
          ref: r(vplus_delivery.flight_end)
          label: 'Flight End'
          format {
            type: 'date'
            pattern: 'LLL d, yyyy'
          }
        }
      ]
      content: @md
        <style>
        .bd-card-v-date-range {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          height: 100%;
          padding: 0.5rem;
          box-sizing: border-box;
        }
        .bd-caption-v-date-range {
          font-size: 13px;
          margin-bottom: 4px;
          color: inherit; opacity: 0.65;
        }
        .bd-value-v-date-range {
          font-size: 30px;
          font-weight: 400;
          line-height: 1.25;
          color: inherit;
        }
        </style>

        <div class="bd-card-v-date-range">
          <div class="bd-caption-v-date-range">Date Range</div>
          <div class="bd-value-v-date-range">{{ rows[0].values.`Flight Start`.formatted }} - {{ rows[0].values.`Flight End`.formatted }}</div>
        </div>
      ;;
    }
  }

  block v_screen_count: VizBlock {
    label: 'Screen Count'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: vplus_delivery
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.screen_count)
          label: 'Screen Count'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      content: @md
        <style>
        .bd-card-v-screen-count {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          height: 100%;
          padding: 0.5rem;
          box-sizing: border-box;
        }
        .bd-caption-v-screen-count {
          font-size: 13px;
          margin-bottom: 4px;
          color: inherit; opacity: 0.65;
        }
        .bd-value-v-screen-count {
          font-size: 30px;
          font-weight: 400;
          line-height: 1.25;
          color: inherit;
        }
        </style>

        <div class="bd-card-v-screen-count">
          <div class="bd-caption-v-screen-count">Screen Count</div>
          <div class="bd-value-v-screen-count">{{ rows[0].values.`Screen Count`.formatted }}</div>
        </div>
      ;;
    }
  }

  block v_cpm: VizBlock {
    label: 'CPM'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: vplus_delivery
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.cpm)
          label: 'CPM'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        }
      ]
      content: @md
        <style>
        .bd-card-v-cpm {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          height: 100%;
          padding: 0.5rem;
          box-sizing: border-box;
        }
        .bd-caption-v-cpm {
          font-size: 13px;
          margin-bottom: 4px;
          color: inherit; opacity: 0.65;
        }
        .bd-value-v-cpm {
          font-size: 30px;
          font-weight: 400;
          line-height: 1.25;
          color: inherit;
        }
        </style>

        <div class="bd-card-v-cpm">
          <div class="bd-caption-v-cpm">CPM</div>
          <div class="bd-value-v-cpm">{{ rows[0].values.`CPM`.formatted }}</div>
        </div>
      ;;
    }
  }

  block v_provinces: VizBlock {
    label: 'Flight Provinces'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: vplus_delivery
      rows: [
        VizFieldFull {
          ref: r(vplus_flight_screens.province)
          label: 'Flight Provinces'
        }
      ]
      content: @md
        <style>
        .bd-prov {
          text-align: center;
          height: 100%;
          box-sizing: border-box;
          color: inherit;
        }
        .bd-prov-head {
          font-size: 12px;
          font-weight: 700;
          padding: 4px 0 6px 0;
          border-bottom: 1px solid rgba(128, 128, 128, 0.5);
          margin-bottom: 6px;
        }
        .bd-prov-row {
          font-size: 14px;
          font-weight: 700;
          line-height: 1.5;
        }
        </style>

        <div class="bd-prov">
          <div class="bd-prov-head">Flight Provinces</div>
          {% map(rows) %}
          <div class="bd-prov-row">{{ `Flight Provinces`.formatted }}</div>
          {% end %}
        </div>
      ;;
    }
  }

  block t_impressions: TextBlock {
    content: @md
<div style="font-size:20px;font-weight:700;letter-spacing:0.3px;padding-top:28px;">IMPRESSIONS</div>
