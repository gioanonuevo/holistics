  block k_vs_network: VizBlock {
    label: 'Attention Seconds vs Network'
    settings {
      hide_label: true
    }
    viz: MarkdownViz {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      values: [
        VizFieldFull {
          ref: r(attention.attention_vs_network_label)
          label: 'Attention Seconds vs Network'
          format {
            type: 'text'
          }
        }
      ]
      content: @md
        <style>
        .bd-card-k-vs-network {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          height: 100%;
          padding: 0.5rem;
          box-sizing: border-box;
        }
        .bd-head-k-vs-network {
          font-size: 15px;
          font-weight: 600;
          margin-bottom: 10px;
          color: inherit;
        }
        .bd-caption-k-vs-network {
          font-size: 13px;
          margin-bottom: 4px;
          color: #6C4DC4;
        }
        .bd-value-k-vs-network {
          font-size: 24px;
          font-weight: 400;
          line-height: 1.25;
          color: #6C4DC4;
        }
        </style>

        <div class="bd-card-k-vs-network">
          <div class="bd-head-k-vs-network">vs Our Network</div>
          <div class="bd-caption-k-vs-network">Attention Seconds vs Network</div>
          <div class="bd-value-k-vs-network">{{ rows[0].values.`Attention Seconds vs Network`.raw }}</div>
        </div>
      ;;
    }
  }

  block t_avg_attention: TextBlock {
    content: @md
<div style="font-size:12px;line-height:1.45;opacity:0.85;">Our anonymous video analytics (AVA) data tells you the average time people spent watching your ad. To calculate this, we use data based on when attention is given to our screens during the time of our ad plays.</div>
    ;;
  }

  block t_active_attention: TextBlock {
    content: @md
<div style="font-size:12px;line-height:1.45;opacity:0.85;">Attention longer than 2.5 seconds significantly increases recall and is considered to be Active Attention.</div>
    ;;
  }

  block t_mediums: TextBlock {
    content: @md
<div style="font-size:12px;line-height:1.45;opacity:0.85;">Traditional billboards are typically viewed for around 2 seconds and digital ads (including DOOH) for even less time at around 1.5 seconds. This metric shows your elevator ad view time compared to these benchmarks.</div>
    ;;
  }

  block t_network: TextBlock {
    content: @md
<div style="font-size:12px;line-height:1.45;opacity:0.85;">This metric compares your campaign's attention average to all other campaigns on the network. If you'd like an in-depth analysis, consider our Premium tier Reporting.</div>
    ;;
  }

  block v_attention_over_time: VizBlock {
    label: 'Attention Over Time'
    viz: CombinationChart {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      x_axis: VizFieldFull {
        ref: r(attention_base.start_date_local)
        label: 'Start At Local Date'
        format {
          type: 'date'
          pattern: 'LLL d'
        }
      }
      y_axis {
        label: 'Attention'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(attention.attention_vs_campaign)
            label: 'Attention'
            format {
              type: 'number'
              pattern: '#,###0.00%'
            }
          }
          settings {
            color: '#6C4DC4'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: false
        row_limit: 1000
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block t_over_time: TextBlock {
    content: @md
<div style="font-size:13px;line-height:1.5;"><b>About Ad Attention over Time:</b> this graph shows fluctuations in overall attention across all demographics during your campaign. Ad attention can be impacted by the day of the week, ad frequency, ad fatigue, geo-political events, weather, and many more factors.</div>
    ;;
  }

  block t_audience_banner: TextBlock {
    content: @md
<div style="background:#6C4DC4;color:#ffffff;font-weight:700;letter-spacing:1px;font-size:16px;padding:14px 18px;clip-path:polygon(0 0,100% 0,98% 100%,0 100%);">AUDIENCE SUMMARY</div>
    ;;
  }

  block t_audience: TextBlock {
    content: @md
<div style="font-size:13px;line-height:1.5;"><b>Ad Attention by Demographic:</b> This shows how your campaign performed across demographic groups (gender and age).</div>
    ;;
  }

  block v_gender_cards: VizBlock {
    label: 'Overall Demographic Attention'
    viz: MarkdownViz {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      rows: [
        VizFieldFull {
          ref: r(attention_base.gender)
          label: 'Gender'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(attention.attention_seconds_average)
          label: 'Average Attention'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      content: @md
        <style>
        .gc-wrap {
          display: flex;
          gap: 12px;
          justify-content: center;
          align-items: stretch;
          height: 100%;
        }
        .gc-card {
          flex: 1;
          display: flex;
          justify-content: space-around;
          align-items: center;
          text-align: center;
          border: 1px solid rgba(128, 128, 128, 0.35);
          border-radius: 6px;
          padding: 8px;
        }
        .gc-cap {
          font-size: 12px;
          margin-bottom: 2px;
        }
        .gc-val {
          font-size: 24px;
          line-height: 1.25;
        }
        .gc-Women { color: #6C4DC4; }
        .gc-Men { color: #1FC8B8; }
        </style>

        <div class="gc-wrap">
          {% map(rows) %}
          <div class="gc-card">
            <div class="gc-{{ `Gender`.raw }}"><div class="gc-cap">Gender</div><div class="gc-val">{{ `Gender`.raw }}</div></div>
            <div><div class="gc-cap">Average Attention</div><div class="gc-val">{{ values.`Average Attention`.formatted }}</div></div>
          </div>
          {% end %}
        </div>
      ;;
    }
  }

  block v_demographic: VizBlock {
    label: 'Ad Attention by Demographic'
    viz: DataTable {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      fields: [
        VizFieldFull {
          ref: r(attention_base.gender)
          label: 'Gender'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(attention_base.age_group)
          label: 'Age Group'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(attention.attention_seconds_average)
          label: 'Average Attention'
          format {
            type: 'number'
            pattern: '#,###0.0'
          }
        },
        VizFieldFull {
          ref: r(attention.attention_vs_gender_average)
          label: 'Attention'
          format {
            type: 'number'
            pattern: '#,###0.00%'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 100
        sorts: [
          IndexBasedSortSetting {
            field_index: 0
            direction: 'asc'
          },
          IndexBasedSortSetting {
            field_index: 1
            direction: 'asc'
          }
        ]
      }
    }
  }

  block v_gender_donut: VizBlock {
    label: 'Audience Gender Breakdown'
    viz: PieChart {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      filter {
        field: r(attention_base.gender_pie)
        operator: 'is_not'
        value: 'Not Confident'
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      legend: VizFieldFull {
        ref: r(attention_base.gender_pie)
        label: 'Gender'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(attention.campaign_datapoints)
          label: 'Datapoints'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
        settings {
          point {
            value: 'Men'
            color: '#1FC8B8'
          }
          point {
            value: 'Women'
            color: '#6C4DC4'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: false
        show_percentage: true
        row_limit: 100
      }
    }
  }

  block v_age_donut: VizBlock {
    label: 'Audience Age Breakdown'
    viz: PieChart {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      filter {
        field: r(attention_base.gender_pie)
        operator: 'is_not'
        value: 'Not Confident'
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      legend: VizFieldFull {
        ref: r(attention_base.age_group)
        label: 'Age Group'
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(attention.campaign_datapoints)
          label: 'Datapoints'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: false
        show_percentage: true
        row_limit: 100
      }
    }
  }

  block t_creative_banner: TextBlock {
    content: @md
<div style="background:#6C4DC4;color:#ffffff;font-weight:700;letter-spacing:1px;font-size:16px;padding:14px 18px;clip-path:polygon(0 0,100% 0,98% 100%,0 100%);">CREATIVE SUMMARY</div>
    ;;
  }

  block t_creative: TextBlock {
    content: @md
<div style="font-size:13px;line-height:1.5;"><b>About Ad Attention By Creative:</b> This chart shows a breakdown of each creative your flight ran, along with the amount of served impressions, average attention in seconds, and ad attention score. Use this to learn which creative performed the best overall.</div>
    ;;
  }

  block v_creatives: VizBlock {
    label: 'Ad Creative Performance'
    viz: DataTable {
      dataset: attention
      filter {
        field: r(attention_base.is_in_flight_range)
        operator: 'is'
        value: true
      }
      conditions: [
        'filter_model.report_filter in attention_base.report_filter'
      ]
      fields: [
        VizFieldFull {
          ref: r(ad_facts.campaign_id)
          label: 'Campaign ID'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(attention_base.ad_id)
          label: 'Ad ID'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ad_facts.name)
          label: 'Name'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ad_facts.type)
          label: 'Type'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ad_facts.date_range)
          label: 'Date Range'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ad_facts.date_progress)
          label: 'Date Progress'
          format {
            type: 'number'
            pattern: '#,###0%'
          }
        },
        VizFieldFull {
          ref: r(attention.attention_seconds_average)
          label: 'Avg Attention Sec'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          ref: r(attention.attention_vs_campaign)
          label: 'Ad Attention %'
          format {
            type: 'number'
            pattern: '#,###0.00%'
          }
        }
      ]
      settings {
        show_row_number: true
        wrap_cell_text: true
        row_limit: 1000
        sorts: [
          IndexBasedSortSetting {
            field_index: 6
            direction: 'asc'
          }
        ]
      }
    }
  }

  block v_imp_week_creative: VizBlock {
    label: 'Impressions by Week and Creative'
    viz: PivotTable {
      dataset: vplus_delivery
      rows: [
        VizFieldFull {
          ref: r(vplus_served_impressions.ad_id)
          label: 'Ad ID'
          format {
            type: 'text'
          }
        }
      ]
      columns: [
        VizFieldFull {
          ref: r(vplus_served_impressions.date)
          label: 'Date Week'
          transformation: 'datetrunc week'
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.served_impressions)
          label: 'Impressions'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: false
        row_limit: 5000
      }
    }
  }

  block v_imp_week_property: VizBlock {
    label: 'Impressions by Week and Property'
    viz: PivotTable {
      dataset: vplus_delivery
      rows: [
        VizFieldFull {
          ref: r(vplus_property_impressions.property_id)
          label: 'ID'
          format {
            type: 'number'
            pattern: '0'
          }
        },
        VizFieldFull {
          ref: r(vplus_property_impressions.property_name)
          label: 'Name'
          format {
            type: 'text'
          }
        }
      ]
      columns: [
        VizFieldFull {
          ref: r(vplus_property_impressions.date)
          label: 'Date Week'
          transformation: 'datetrunc week'
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.property_impressions)
          label: 'Impressions'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: false
        row_limit: 5000
      }
    }
  }

  block v_imp_week_city: VizBlock {
    label: 'Impressions by Week and City'
    viz: PivotTable {
      dataset: vplus_delivery
      rows: [
        VizFieldFull {
          ref: r(vplus_property_impressions.city)
          label: 'City'
          format {
            type: 'text'
          }
        }
      ]
      columns: [
        VizFieldFull {
          ref: r(vplus_property_impressions.date)
          label: 'Date Week'
          transformation: 'datetrunc week'
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.property_impressions)
          label: 'Impressions'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: false
        row_limit: 5000
      }
    }
  }

  block v_imp_day_city: VizBlock {
    label: 'Impressions by Day and City'
    viz: PivotTable {
      dataset: vplus_delivery
      rows: [
        VizFieldFull {
          ref: r(vplus_property_impressions.city)
          label: 'City'
          format {
            type: 'text'
          }
        }
      ]
      columns: [
        VizFieldFull {
          ref: r(vplus_property_impressions.date)
          label: 'Date Day'
          transformation: 'datetrunc day'
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(vplus_delivery.property_impressions)
          label: 'Impressions'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      settings {
        show_row_total: false
        show_column_total: false
        row_limit: 5000
      }
    }
  }

  block t_disclaimer: TextBlock {
    content: @md
<div style="font-size:13px;line-height:1.5;"><div style="font-size:18px;font-weight:700;text-align:center;padding-bottom:6px;">Disclaimer</div>
<p><b>About our data collection:</b> We collect a statistically significant sample of audience traffic in elevators to provide results for each campaign. In cases where we do not collect enough data in a specific area, we will omit those results from this dashboard.</p>
<p><b>About Ad Attention:</b> Our proprietary metric. It tells you which audiences are most engaged, relative to the rest of the campaign. It is calculated from thousands of real-time data points.</p>
<p>Ad attention measures are derived from Anonymous Video Analytics (AVA), which is subject to many factors such as changes in lighting, mount position of the screen, updates to facial detection and demographic analysis algorithms. AVA uses AI pattern detection algorithms to scan real-time video feeds, looking for patterns that match the software's understanding of faces.</p></div>
    ;;
  }

  block t_dictionary: TextBlock {
    content: @md
### Data Dictionary

| Metric | Definition |
|---|---|
| Attention vs Campaign Average | % difference of certain segment's average attention seconds compared to your overall campaign average |
| Active Attention | Attention longer than 2.5 seconds* significantly increases recall and is considered Active Attention |
| Attention Seconds vs Digital/DOOH benchmark | Average time spent viewing your ad, compared to 1.5 seconds* benchmark typically attained by other Digital/DOOH media. |
| Attention Seconds vs Static OOH | Average time spent viewing your ad compared to 2.0 seconds* benchmark typically attained by Static OOH media |
    ;;
  }

  interactions: [
    FilterInteraction {
      from: 'flight_id'
      to: [
        CustomMapping {
          block: [
            'v_date_range',
            'v_screen_count',
            'v_provinces',
            'v_cpm',
            'v_booked_impressions',
            'v_impressions',
            'v_bonus_impressions',
            'v_total_contract_cost',
            'v_rate_card_value',
            'v_bonus_value',
            'v_imp_week_creative',
            'v_imp_week_property',
            'v_imp_week_city',
            'v_imp_day_city'
          ]
          field: r(vplus_flight_facts.campaign_id)
        },
        CustomMapping {
          block: [
            'k_avg_attention',
            'k_active_attention',
            'k_vs_digital',
            'k_vs_ooh',
            'k_vs_network',
            'v_attention_over_time',
            'v_gender_cards',
            'v_demographic',
            'v_gender_donut',
            'v_age_donut',
            'v_creatives'
          ]
          field: r(attention_base.report_filter)
        }
      ]
    }
  ]

  view: TabLayout {
    tab main: CanvasLayout {
      label: 'Core Dashboard'
      width: 1220
      height: 5360
      grid_size: 20
      auto_expand_vertically: true
      block flight_id { position: pos(20, 20, 280, 100) layer: 1 }
      block t_header { position: pos(20, 140, 880, 80) layer: 1 }
      block t_logo { position: pos(920, 140, 280, 80) layer: 1 }
      block v_date_range { position: pos(20, 240, 580, 160) layer: 1 }
      block v_screen_count { position: pos(620, 240, 180, 160) layer: 1 }
      block v_cpm { position: pos(820, 240, 180, 160) layer: 1 }
      block v_provinces { position: pos(1020, 240, 180, 160) layer: 1 }
      block t_impressions { position: pos(20, 420, 280, 120) layer: 1 }
      block v_booked_impressions { position: pos(320, 420, 280, 120) layer: 1 }
      block v_impressions { position: pos(620, 420, 280, 120) layer: 1 }
      block v_bonus_impressions { position: pos(920, 420, 280, 120) layer: 1 }
      block t_contract { position: pos(20, 560, 280, 120) layer: 1 }
      block v_total_contract_cost { position: pos(320, 560, 280, 120) layer: 1 }
      block v_rate_card_value { position: pos(620, 560, 280, 120) layer: 1 }
      block v_bonus_value { position: pos(920, 560, 280, 120) layer: 1 }
      block t_attention_banner { position: pos(20, 700, 880, 80) layer: 1 }
      block k_avg_attention { position: pos(20, 800, 220, 160) layer: 1 }
      block k_active_attention { position: pos(260, 800, 220, 160) layer: 1 }
      block k_vs_digital { position: pos(500, 800, 220, 160) layer: 1 }
      block k_vs_ooh { position: pos(740, 800, 220, 160) layer: 1 }
      block k_vs_network { position: pos(980, 800, 220, 160) layer: 1 }
      block t_avg_attention { position: pos(20, 980, 220, 160) layer: 1 }
      block t_active_attention { position: pos(260, 980, 220, 160) layer: 1 }
      block t_mediums { position: pos(500, 980, 460, 160) layer: 1 }
      block t_network { position: pos(980, 980, 220, 160) layer: 1 }
      block v_attention_over_time { position: pos(20, 1160, 1180, 380) layer: 1 }
      block t_over_time { position: pos(20, 1560, 1180, 100) layer: 1 }
      block t_audience_banner { position: pos(20, 1680, 880, 80) layer: 1 }
      block t_audience { position: pos(20, 1780, 1180, 80) layer: 1 }
      block v_gender_cards { position: pos(20, 1880, 580, 160) layer: 1 }
      block v_demographic { position: pos(20, 2060, 580, 440) layer: 1 }
      block v_gender_donut { position: pos(620, 1880, 580, 300) layer: 1 }
      block v_age_donut { position: pos(620, 2200, 580, 300) layer: 1 }
      block t_creative_banner { position: pos(20, 2520, 880, 80) layer: 1 }
      block t_creative { position: pos(20, 2620, 1180, 100) layer: 1 }
      block v_creatives { position: pos(20, 2740, 1180, 520) layer: 1 }
      block v_imp_week_creative { position: pos(20, 3280, 1180, 460) layer: 1 }
      block v_imp_week_property { position: pos(20, 3760, 1180, 460) layer: 1 }
      block v_imp_week_city { position: pos(20, 4240, 1180, 220) layer: 1 }
      block v_imp_day_city { position: pos(20, 4480, 1180, 220) layer: 1 }
      block t_disclaimer { position: pos(20, 4720, 1180, 300) layer: 1 }
      block t_dictionary { position: pos(20, 5040, 1180, 300) layer: 1 }
      mobile { mode: 'auto' }
    }
  }
}
