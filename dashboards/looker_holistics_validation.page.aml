  view: TabLayout {
    tab direct: CanvasLayout {
      label: 'Direct 10605'
      width: 1300
      height: 2200
      grid_size: 20
      auto_expand_vertically: true
      block t_intro {
        position: pos(20, 20, 1260, 420)
      }
      block f_report {
        position: pos(20, 460, 620, 80)
      }
      block v_summary {
        position: pos(20, 560, 1260, 240)
        layer: 1
      }
      block v_ads {
        position: pos(20, 820, 1260, 520)
        layer: 1
      }
      block v_gender {
        position: pos(20, 1360, 1260, 220)
        layer: 1
      }
      block v_gender_age {
        position: pos(20, 1600, 1260, 480)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
    tab programmatic: CanvasLayout {
      label: 'Programmatic ads'
      width: 1300
      height: 1800
      grid_size: 20
      auto_expand_vertically: true
      block t_prog {
        position: pos(20, 20, 1260, 180)
      }
      block f_ads {
        position: pos(20, 220, 1260, 80)
      }
      block p_summary {
        position: pos(20, 320, 1260, 240)
        layer: 1
      }
      block p_ads {
        position: pos(20, 580, 1260, 320)
        layer: 1
      }
      block p_gender {
        position: pos(20, 920, 1260, 220)
        layer: 1
      }
      block p_gender_age {
        position: pos(20, 1160, 1260, 480)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  theme: DynamicPageTheme {
    light: H.themes.vanilla
    dark: H.themes.charcoal
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_report'
      to: [
        'v_summary',
        'v_ads',
        'v_gender',
        'v_gender_age'
      ]
      field: r(attention_base.report_filter)
    },
    FilterInteraction {
      from: 'f_ads'
      to: [
        'p_summary',
        'p_ads',
        'p_gender',
        'p_gender_age'
      ]
      field: r(attention_base.report_filter)
    }
  ]
