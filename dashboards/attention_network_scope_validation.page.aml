Dashboard attention_network_scope_validation {
  title: 'Campaign to Network Scope Validation'
  description: 'Shows how one campaign selection changes grain in stages before calculating network-level attention metrics.'
  owner: 'ganonuevo@verticalcity.com'

  block t_intro: TextBlock {
    content: @md
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1180 380" width="100%" height="380" role="img" aria-labelledby="vc-nsg-title vc-nsg-desc" style="display: block;">
  <title id="vc-nsg-title">Campaign to network attention grain and join path</title>
  <desc id="vc-nsg-desc">A four-stage model path. One campaign joins to many campaign scope bridge rows by campaign ID. Many bridge rows join to one deduplicated network scope by network scope key, removing campaign identity. One network scope then joins to many attention events by network scope key.</desc>
  <defs>
    <marker id="vc-nsg-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L8,4 L0,8 z" fill="#94a3b8" />
    </marker>
    <style>
      .vc-nsg-heading { font: 700 18px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #f1f5f9; }
      .vc-nsg-subheading { font: 12px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #94a3b8; }
      .vc-nsg-table-name { font: 700 11px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; fill: #ffffff; }
      .vc-nsg-grain-label { font: 700 9px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; letter-spacing: .08em; fill: #94a3b8; }
      .vc-nsg-grain { font: 600 11px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #e2e8f0; }
      .vc-nsg-field { font: 11px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; fill: #cbd5e1; }
      .vc-nsg-key { font: 700 9px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #7dd3fc; }
      .vc-nsg-relation { stroke: #94a3b8; stroke-width: 2; fill: none; marker-end: url(#vc-nsg-arrow); }
      .vc-nsg-cardinality { font: 700 11px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #94a3b8; }
      .vc-nsg-join-key { font: 600 9px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; fill: #94a3b8; }
      .vc-nsg-boundary { stroke: #f59e0b; stroke-width: 1.5; stroke-dasharray: 4 4; }
      .vc-nsg-callout-title { font: 700 11px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #fcd34d; }
      .vc-nsg-callout-copy { font: 11px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #fde68a; }
      .vc-nsg-footnote { font: 600 11px Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; fill: #94a3b8; }
    </style>
  </defs>

  <rect x="1" y="1" width="1178" height="378" rx="14" fill="none" stroke="#475569" />
  <text id="vc-nsg-visible-title" x="24" y="31" class="vc-nsg-heading">Campaign to network attention</text>
  <text x="24" y="52" class="vc-nsg-subheading">The selected campaign defines a reusable network scope; attention events are matched without campaign ID.</text>

  <g transform="translate(24 82)">
    <rect width="230" height="196" rx="9" fill="#262b38" stroke="#93c5fd" />
    <path d="M9 0 H221 A9 9 0 0 1 230 9 V34 H0 V9 A9 9 0 0 1 9 0" fill="#0284c7" />
    <text x="12" y="22" class="vc-nsg-table-name">data_pipeline_raw_campaigns</text>
    <text x="12" y="55" class="vc-nsg-grain-label">GRAIN</text>
    <text x="12" y="72" class="vc-nsg-grain">one campaign</text>
    <line x1="0" y1="86" x2="230" y2="86" stroke="#3b4252" />
    <text x="12" y="108" class="vc-nsg-key">PK</text>
    <text x="38" y="108" class="vc-nsg-field">campaign_id</text>
    <text x="12" y="134" class="vc-nsg-field">start_at</text>
    <text x="12" y="158" class="vc-nsg-field">end_at</text>
    <text x="12" y="182" class="vc-nsg-field">campaign_name</text>
  </g>

  <g transform="translate(304 82)">
    <rect width="250" height="196" rx="9" fill="#262b38" stroke="#c4b5fd" />
    <path d="M9 0 H241 A9 9 0 0 1 250 9 V34 H0 V9 A9 9 0 0 1 9 0" fill="#7c3aed" />
    <text x="12" y="22" class="vc-nsg-table-name">campaign_network_scope_bridge</text>
    <text x="12" y="55" class="vc-nsg-grain-label">GRAIN</text>
    <text x="12" y="72" class="vc-nsg-grain">campaign × date × property × ad length</text>
    <line x1="0" y1="86" x2="250" y2="86" stroke="#3b4252" />
    <text x="12" y="108" class="vc-nsg-key">PK</text>
    <text x="38" y="108" class="vc-nsg-field">campaign_scope_key</text>
    <text x="12" y="134" class="vc-nsg-key">FK</text>
    <text x="38" y="134" class="vc-nsg-field">campaign_id</text>
    <text x="12" y="160" class="vc-nsg-key">FK</text>
    <text x="38" y="160" class="vc-nsg-field">network_scope_key</text>
    <text x="12" y="184" class="vc-nsg-field">city</text>
  </g>

  <g transform="translate(604 82)">
    <rect width="240" height="196" rx="9" fill="#262b38" stroke="#5eead4" />
    <path d="M9 0 H231 A9 9 0 0 1 240 9 V34 H0 V9 A9 9 0 0 1 9 0" fill="#0f766e" />
    <text x="12" y="22" class="vc-nsg-table-name">network_scope</text>
    <text x="12" y="55" class="vc-nsg-grain-label">GRAIN</text>
    <text x="12" y="72" class="vc-nsg-grain">date × property × ad length</text>
    <line x1="0" y1="86" x2="240" y2="86" stroke="#3b4252" />
    <text x="12" y="108" class="vc-nsg-key">PK</text>
    <text x="38" y="108" class="vc-nsg-field">network_scope_key</text>
    <text x="12" y="134" class="vc-nsg-field">scope_date</text>
    <text x="12" y="158" class="vc-nsg-field">property_id</text>
    <text x="12" y="182" class="vc-nsg-field">ad_length_grouped</text>
  </g>

  <g transform="translate(894 82)">
    <rect width="262" height="196" rx="9" fill="#262b38" stroke="#86efac" />
    <path d="M9 0 H253 A9 9 0 0 1 262 9 V34 H0 V9 A9 9 0 0 1 9 0" fill="#16a34a" />
    <text x="12" y="22" class="vc-nsg-table-name">data_pipeline_attention_seconds_v2</text>
    <text x="12" y="55" class="vc-nsg-grain-label">GRAIN</text>
    <text x="12" y="72" class="vc-nsg-grain">one attention event</text>
    <line x1="0" y1="86" x2="262" y2="86" stroke="#3b4252" />
    <text x="12" y="108" class="vc-nsg-key">PK</text>
    <text x="38" y="108" class="vc-nsg-field">uuid</text>
    <text x="12" y="134" class="vc-nsg-key">FK</text>
    <text x="38" y="134" class="vc-nsg-field">network_scope_key</text>
