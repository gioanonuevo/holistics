        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
  }
  theme: DynamicPageTheme {
    light: vc_dark_theme
    dark: vc_dark_theme
  }
  settings {
    timezone: 'Etc/UTC'
    cache_duration: 1440
    autorun_on_open: true
    autorun_on_changes: true
  }
  explicit_interactions: [
