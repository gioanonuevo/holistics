        layer: 1
      }
      block t_dbdiagram_embed {
        position: pos(20, 20, 1260, 560)
        layer: 1
      }
    }
  }

  theme: DynamicPageTheme {
    light: H.themes.vanilla
    dark: H.themes.charcoal
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_campaign_id'
      to: [
        'v_8ahg'
      ]
      field: ref('ad_length_clipping_helper_v', 'frame_scope_campaign_id')
    },
    FilterInteraction {
      from: 'f_campaign_id'
      to: [
        'v_rb6i'
      ]
      field: ref('data_pipeline_creative_city_mapping', 'frame_scope_campaign_id')
    },
    FilterInteraction {
      from: 'f_campaign_id'
      to: [
        'v_n424',
        'v_rj50'
      ]
      field: ref('flight_date_range_clipping_helper_v', 'frame_scope_campaign_id')
    },
    FilterInteraction {
      from: 'f_1jub'
      to: [
        'v_ojy8',
