  data_source_name: 'vc_data_warehouse'
  dimension flight_id {
    label: 'Flight Id'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.flight_id }};;
  }
  dimension campaign_id {
    label: 'Campaign Id'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.campaign_id }};;
  }
  dimension name {
    label: 'Name'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.name }};;
  }
  dimension start_at {
    label: 'Start At'
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.start_at }};;
  }
  dimension end_at {
    label: 'End At'
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.end_at }};;
  }
  dimension fullscreen {
    label: 'Fullscreen'
    type: 'truefalse'
    hidden: false
    definition: @sql {{ #SOURCE.fullscreen }};;
  }
  dimension contract_value_in_cents {
    label: 'Contract Value In Cents'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.contract_value_in_cents }};;
  }
  dimension booked_impressions {
    label: 'Booked Impressions'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.booked_impressions }};;
  }
  dimension created_at {
    label: 'Created At'
    type: 'datetime'
    hidden: false
    definition: @sql {{ #SOURCE.created_at }};;
  }
  dimension updated_at {
    label: 'Updated At'
    type: 'datetime'
    hidden: false
    definition: @sql {{ #SOURCE.updated_at }};;
  }
  dimension ad_length {
    label: 'Ad Length'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.ad_length }};;
  }
  dimension flight_number {
    label: 'Flight Number'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.flight_number }};;
  }
  dimension currency_code {
    label: 'Currency Code'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.currency_code }};;
  }

  owner: 'ganonuevo@verticalcity.com'
  table_name: '`data_pipeline`.`campaign_reporting_flights`'
