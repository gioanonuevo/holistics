  }
  dimension creative_category {
    label: 'Creative Category'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.creative_category }};;
  }
  dimension content_type {
    label: 'Content Type'
    type: 'text'
    hidden: false
