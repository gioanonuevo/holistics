    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.campaign_name }};;
  }
  dimension start_at {
    label: 'Start At'
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.start_at }};;
  }
  dimension end_at {
    label: 'End At'
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.end_at }};;
  }
  dimension campaign_type {
    label: 'Campaign Type'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.campaign_type }};;
  }
  dimension advertiser {
    label: 'Advertiser'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.advertiser }};;
  }
  dimension agency {
    label: 'Agency'
    type: 'text'
    hidden: false
