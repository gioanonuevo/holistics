Model network_scope_v2 {
  type: 'query'
  label: 'Network Scope'
  description: 'One row per date, property, and grouped ad length used as the conformed scope between campaigns and attention facts.'
  data_source_name: 'vc_data_warehouse'
  owner: 'ganonuevo@verticalcity.com'

  query: @sql
    select distinct
       mapping.city
      , case
          when campaigns.ad_length between 5 and 7 then 5
          when campaigns.ad_length between 8 and 12 then 10
          when campaigns.ad_length between 13 and 16 then 15
          when campaigns.ad_length between 17 and 22 then 20
          when campaigns.ad_length between 28 and 32 then 30
          else campaigns.ad_length
        end as ad_length_grouped
    from `data_pipeline.stg_campaigns` as campaigns
    inner join `data_pipeline.creative_city_mapping` as mapping
      on campaigns.campaign_id = mapping.campaign_id
      and campaigns.ad_id = mapping.ad_id
    inner join `data_pipeline.properties` as properties
      on mapping.city = properties.city
  ;;

  dimension network_scope_key {
    label: 'Network Scope Key'
    type: 'text'
    primary_key: true
    definition: @sql
      concat(
        cast({{ city }} as string)
        , '||'
        , cast({{ ad_length_grouped }} as string)
      )
    ;;
  }


  dimension city {
    label: 'City'
    type: 'text'
    definition: @sql {{ #SOURCE.city }};;
  }

  dimension ad_length_grouped {
    label: 'Ad Length Grouped'
    type: 'number'
    definition: @sql {{ #SOURCE.ad_length_grouped }};;
  }
}