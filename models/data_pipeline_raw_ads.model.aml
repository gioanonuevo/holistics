  }
  dimension end_date {
    label: 'End Date'
    type: 'datetime'
    hidden: false
    definition: @sql {{ #SOURCE.end_date }};;
  }
  dimension type {
    label: 'Type'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.type }};;
  }
  dimension duration {
    label: 'Duration'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.duration }};;
  }

